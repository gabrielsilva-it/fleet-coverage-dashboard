{
  "__inputs": [
    {
      "name": "DS_PARQUE",
      "label": "InfluxDB parque",
      "description": "Banco parque do coletor do parque",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    }
  ],
  "uid": "parque-detalhe",
  "title": "Parque - Detalhe",
  "tags": [
    "parque",
    "ti"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "hidden": false
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "datasource": null,
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "# PARQUE · MÁQUINA A MÁQUINA\n"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_PARQUE}"
      },
      "transparent": true,
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_PARQUE}"
          },
          "query": "SELECT last(\"ativas\") FROM \"parque_geral\" WHERE time > now() - 2h",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Time$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 12,
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "time:[Atualizado em] DD/MM [às] HH:mm",
          "noValue": "SEM DADOS",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5C6773"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ESTAÇÕES EM USO",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_PARQUE}"
      },
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 5
      },
      "description": "Estações do domínio com logon nos últimos 30 dias (base de tudo). Embaixo: total de estações no AD.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_PARQUE}"
          },
          "query": "SELECT last(\"ativas\") AS \"EM USO\", last(\"ad_estacoes\") AS \"NO AD\" FROM \"parque_geral\" WHERE time > now() - 30m",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "SEM DADOS",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3F7FBF"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*EM USO$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "EM USO"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*NO AD$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "NO AD"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5C6773"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "COMPLETAS (AS 3)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_PARQUE}"
      },
      "transparent": true,
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 5,
        "h": 5
      },
      "description": "Estações em uso com Kaspersky, Tactical e GLPI respondendo nos últimos 7 dias.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_PARQUE}"
          },
          "query": "SELECT last(\"pct_completas\") FROM \"parque_geral\" WHERE $timeFilter GROUP BY time(30m) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 44
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "noValue": "SEM DADOS",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D64545",
                "value": null
              },
              {
                "color": "#D9A441",
                "value": 85
              },
              {
                "color": "#2E9E6B",
                "value": 97
              }
            ]
          }
        },
        "overrides": []
      }
    },
