    {
      "id": 30,
      "type": "table",
      "title": "MÁQUINAS · USE O FILTRO DE CADA COLUNA (FUNIL NO CABEÇALHO)",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_PARQUE}"
      },
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_PARQUE}"
          },
          "query": "SELECT last(\"usuario\") AS \"usuario\", last(\"ip\") AS \"ip\", last(\"situacao\") AS \"situacao\", last(\"faltando\") AS \"faltando\", last(\"ad_dias\") AS \"ad_dias\", last(\"tactical_dias\") AS \"tactical_dias\", last(\"glpi_dias\") AS \"glpi_dias\", last(\"ksc_dias\") AS \"ksc_dias\", last(\"ksc_ok\") AS \"ksc_ok\", last(\"tactical_ok\") AS \"tactical_ok\", last(\"glpi_ok\") AS \"glpi_ok\", last(\"so\") AS \"so\", last(\"modelo\") AS \"modelo\", last(\"serial\") AS \"serial\", last(\"ou\") AS \"ou\", last(\"glpi_estado\") AS \"glpi_estado\", last(\"glpi_cadastros\") AS \"glpi_cadastros\" FROM \"parque_maquina\" WHERE time > now() - 30m AND \"unidade\" =~ /^$unidade$/ AND \"tipo\" =~ /^$tipo$/ GROUP BY \"maquina\", \"unidade\", \"tipo\"",
          "rawQuery": true,
          "resultFormat": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "maquina": "Máquina",
              "unidade": "Unidade",
              "tipo": "Tipo",
              "usuario": "Usuário",
              "ip": "IP",
              "situacao": "Situação",
              "faltando": "Falta",
              "ad_dias": "Logon AD (dias)",
              "tactical_dias": "Tactical (dias)",
              "glpi_dias": "GLPI (dias)",
              "ksc_dias": "Kaspersky (dias)",
              "ksc_ok": "Kaspersky",
              "tactical_ok": "Tactical",
              "glpi_ok": "GLPI",
              "so": "Sistema",
              "modelo": "Modelo",
              "serial": "Série",
              "ou": "OU",
              "glpi_estado": "Estado no GLPI",
              "glpi_cadastros": "Cadastros GLPI"
            },
            "indexByName": {
              "maquina": 0,
              "unidade": 1,
              "usuario": 2,
              "ip": 3,
              "situacao": 4,
              "ksc_ok": 5,
              "tactical_ok": 6,
              "glpi_ok": 7,
              "ad_dias": 8,
              "ksc_dias": 9,
              "tactical_dias": 10,
              "glpi_dias": 11,
              "faltando": 12,
              "tipo": 13,
              "so": 14,
              "modelo": 15,
              "serial": 16,
              "glpi_estado": 17,
              "glpi_cadastros": 18,
              "ou": 19
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": true,
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Situação",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Kaspersky"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "✔",
                        "color": "#2E9E6B",
                        "index": 0
                      },
                      "false": {
                        "text": "✖",
                        "color": "#D64545",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
