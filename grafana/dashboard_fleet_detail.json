  "templating": {
    "list": [
      {
        "name": "unidade",
        "label": "Unidade",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS_PARQUE}"
        },
        "query": "SHOW TAG VALUES FROM \"parque_maquina\" WITH KEY = \"unidade\"",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
